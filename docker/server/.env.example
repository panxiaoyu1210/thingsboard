# 必须修改：使用固定版本标签，禁止生产环境使用 latest 或 SNAPSHOT。
THINGSBOARD_IMAGE=CHANGE_ME_REGISTRY/tb-node:CHANGE_ME_VERSION
WAN_TRANSPORT_IMAGE=CHANGE_ME_REGISTRY/tb-wan-transport:CHANGE_ME_VERSION

# 第三方运行时镜像。上线前建议同步到自己的镜像仓库并固定版本或 digest。
POSTGRES_IMAGE=postgres:16
ZOOKEEPER_IMAGE=zookeeper:3.8.1
KAFKA_IMAGE=bitnamilegacy/kafka:4.0
VALKEY_IMAGE=bitnamilegacy/valkey:8.0

# 必须修改：数据库和缓存密码建议使用 `openssl rand -hex 24` 生成。
POSTGRES_DB=thingsboard
POSTGRES_USER=thingsboard
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
VALKEY_PASSWORD=CHANGE_ME_VALKEY_PASSWORD

# 必须原样迁移：填写当前开发环境 .env 中的同名值，不能重新生成。
WAN_CONNECTION_PASSWORD_ENCRYPTION_KEY=CHANGE_ME_COPY_FROM_SOURCE_ENV

# 必须修改或确认：生产域名/IP需要在天地图控制台的 Key 白名单内。
UI_MAP_TIANDITU_API_KEY=CHANGE_ME_TIANDITU_API_KEY
UI_MAP_TIANDITU_DEFAULT_LAYER=vector
UI_MAP_TIANDITU_DEFAULT_CENTER_LATITUDE=35.8617
UI_MAP_TIANDITU_DEFAULT_CENTER_LONGITUDE=104.1954
UI_MAP_TIANDITU_DEFAULT_ZOOM=4

# 部署标识和时区。
COMPOSE_PROJECT_NAME=thingsboard-prod
TZ=Asia/Shanghai

# Web 默认只监听本机，由宿主机 Nginx 转发。
TB_WEB_BIND_ADDRESS=127.0.0.1
TB_HTTP_PORT=8080

# 当前 WAN 终端通过 NS 接入，不需要直接暴露 ThingsBoard MQTT。
# 如有普通 MQTT 设备需要公网直连，再将地址改为 0.0.0.0 并配置 TLS/防火墙。
TB_MQTT_BIND_ADDRESS=127.0.0.1
TB_MQTT_PORT=1883

# WAN 健康检查和 Prometheus 指标默认只监听本机。
WAN_METRICS_BIND_ADDRESS=127.0.0.1
WAN_METRICS_PORT=8086

# 单机生产默认值，可根据服务器资源调整。
TB_JAVA_OPTS=-Xms1g -Xmx4g -Xss384k -XX:+ExitOnOutOfMemoryError
WAN_JAVA_OPTS=-Xms256m -Xmx1g -Xss384k -XX:+ExitOnOutOfMemoryError
TB_MEMORY_LIMIT=5g
WAN_MEMORY_LIMIT=1536m
POSTGRES_MEMORY_LIMIT=2g
KAFKA_MEMORY_LIMIT=2g
VALKEY_MEMORY_LIMIT=768m
ZOOKEEPER_MEMORY_LIMIT=512m

# WAN 生产轮询参数。通常保持默认即可。
WAN_CONFIG_REFRESH_INTERVAL_MS=30000
WAN_SYNC_POLL_INTERVAL_MS=30000
